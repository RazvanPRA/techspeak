# Copy to .env and fill in. .env is git-ignored; never commit real keys.
PORT=3000
DATABASE_URL=postgresql://techspeak:techspeak@localhost:5432/techspeak
# Shared key between the app and this server (header x-api-key). Any long random string.
API_KEY=
# Azure Speech resource on the F0 (free) tier.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: path to an ffmpeg binary. Defaults to the one bundled by ffmpeg-static.
FFMPEG_PATH=
# Optional: a local Ollama server for grammar corrections + an improved answer ($0).
# Empty = rule-based feedback only. Setup: docs/progress.md, milestone 5 part 2.
OLLAMA_URL=
OLLAMA_MODEL=qwen3.5:2b
# Must stay under the app's 15 s timeout (max 13000).
OLLAMA_TIMEOUT_MS=12000
